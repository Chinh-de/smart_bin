[Unit]
Description=Smartbin controller (camera + model + servo)
After=smartbin-server.service
Wants=smartbin-server.service

[Service]
User=pi
WorkingDirectory=/home/pi/smartbin_pi
ExecStart=/home/pi/smartbin_pi/.venv/bin/python main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
